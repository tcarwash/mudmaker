# Keep this file's private copy as .env; never commit real values.
MUDMAKER_BIND=127.0.0.1
MUDMAKER_PORT=8081
MUDMAKER_ADMIN_USERNAME=admin
MUDMAKER_ADMIN_PASSWORD=
MUDMAKER_OPENAI_API_KEY=

# MCP is bound to loopback and requires its own bearer token.
# Leave empty to generate a private token in the persistent data volume.
MUDMAKER_MCP_TOKEN=
MUDMAKER_MCP_BIND=127.0.0.1
MUDMAKER_MCP_PORT=8082
# Comma-separated Host headers when accessing through a proxy, e.g. studio.home:*
MUDMAKER_MCP_ALLOWED_HOSTS=
